{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true,
        "category": "coding-agent-release"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-js",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "coding-agent-release"
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "servers",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "model-tooling-release"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "inference-release"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "inference-release"
      },
      {
        "type": "repo_releases",
        "owner": "ggml-org",
        "repo": "llama.cpp",
        "enabled": true,
        "category": "inference-release"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "category": "community"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "GitHub Trending - Python",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/python.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "GitHub Trending - TypeScript",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/typescript.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Fireship (YouTube)",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCsBjURrPoezykLs9EqgamOA",
        "enabled": true,
        "category": "video"
      },
      {
        "name": "Matthew Berman (YouTube)",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCawZsQWqfGSbCI5yjkdVkTA",
        "enabled": true,
        "category": "video"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "technical-analysis"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "ClaudeCode",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 80,
          "category": "community-practical"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 100,
          "category": "community-practical"
        },
        {
          "subreddit": "mcp",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 40,
          "category": "community-practical"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "Python",
        "TypeScript",
        "Rust",
        "C++"
      ],
      "keywords": [
        "llm",
        "agent",
        "mcp",
        "inference",
        "multimodal",
        "rag",
        "embedding"
      ],
      "min_stars": 80,
      "max_items": 12,
      "category": "oss-trending"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 10,
    "category_groups": {
      "official": {
        "limit": 6,
        "categories": [
          "official-ai-news",
          "coding-agent-release",
          "agent-sdk-release",
          "model-tooling-release",
          "inference-release"
        ]
      },
      "open-source-discovery": {
        "limit": 3,
        "categories": [
          "oss-trending",
          "github-trending"
        ]
      },
      "analysis": {
        "limit": 2,
        "categories": [
          "technical-analysis"
        ]
      },
      "community": {
        "limit": 2,
        "categories": [
          "community",
          "community-practical",
          "video"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
