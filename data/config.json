{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "${HORIZON_AI_MODEL}",
    "api_key_env": "HORIZON_AI_API_KEY",
    "base_url": "${HORIZON_AI_BASE_URL}",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 4,
    "enrichment_concurrency": 2,
    "languages": ["zh"]
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "placeholder@example.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true,
        "category": "coding-agent-release"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-js",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "coding-agent-release"
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "servers",
        "enabled": true,
        "category": "agent-sdk-release"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "model-tooling-release"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "inference-release"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "inference-release"
      },
      {
        "type": "repo_releases",
        "owner": "ggml-org",
        "repo": "llama.cpp",
        "enabled": true,
        "category": "inference-release"
      },
      {
        "type": "repo_search",
        "query": "skills in:name,description",
        "sort": "stars",
        "order": "desc",
        "fetch_limit": 25,
        "min_stars": 500,
        "lookback_days": 14,
        "enabled": true,
        "category": "skills-hotspot"
      },
      {
        "type": "repo_search",
        "query": "topic:agent-skills",
        "sort": "stars",
        "order": "desc",
        "fetch_limit": 20,
        "min_stars": 50,
        "lookback_days": 14,
        "enabled": true,
        "category": "skills-hotspot"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "category": "community"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "official-ai-news"
      },
      {
        "name": "GitHub Trending - Python",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/python.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "GitHub Trending - TypeScript",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/typescript.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Fireship (YouTube)",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCsBjURrPoezykLs9EqgamOA",
        "enabled": true,
        "category": "video"
      },
      {
        "name": "Matthew Berman (YouTube)",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCawZsQWqfGSbCI5yjkdVkTA",
        "enabled": true,
        "category": "video"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "technical-analysis"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "ClaudeCode",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 10,
          "category": "community-practical"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 30,
          "category": "community-practical"
        },
        {
          "subreddit": "mcp",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 10,
          "category": "community-practical"
        },
        {
          "subreddit": "AI_Agents",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 10,
          "category": "community-practical"
        },
        {
          "subreddit": "claudeskills",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 5,
          "category": "community-practical"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript", "Rust", "C++"],
      "keywords": ["llm", "agent", "mcp", "skill", "claude", "codex", "cursor", "inference", "multimodal", "rag", "embedding"],
      "min_stars": 20,
      "max_items": 20,
      "category": "oss-trending"
    },
    "google_news": {
      "enabled": true,
      "query": "(\"agent skills\" OR \"Claude Code skills\" OR \"Codex skills\" OR \"mattpocock skills\")",
      "language": "en",
      "country": "US",
      "max_results": 30,
      "category": "community-practical"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 14,
    "category_groups": {
      "official": {
        "limit": 5,
        "categories": [
          "official-ai-news",
          "coding-agent-release",
          "agent-sdk-release",
          "model-tooling-release",
          "inference-release"
        ]
      },
      "open-source-discovery": {
        "limit": 4,
        "categories": ["oss-trending", "github-trending", "skills-hotspot"]
      },
      "analysis": {
        "limit": 2,
        "categories": ["technical-analysis"]
      },
      "community": {
        "limit": 4,
        "categories": ["community", "community-practical", "video"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
